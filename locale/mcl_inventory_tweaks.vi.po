#: lib/ui.lua:30
msgid "Use & for all conditions, | for either alternative, and ! to exclude. & applies within each alternative. * matches everything; inside an item identifier, * matches any text and ? one character."
msgstr "Dùng & để yêu cầu mọi điều kiện, | để chọn một trong các phương án và ! để loại trừ. & áp dụng trong từng phương án. * khớp mọi thứ; trong mã vật phẩm, * khớp chuỗi bất kỳ và ? khớp một ký tự."

#: lib/ui.lua:624
msgid "Use /inv, /inv sort, /inv columns, /inv merge, /inv refill, /inv undo or /inv settings."
msgstr "Dùng /inv, /inv sort, /inv columns, /inv merge, /inv refill, /inv undo hoặc /inv settings."

