#: lib/ui.lua:624
msgid "Use /inv, /inv sort, /inv columns, /inv merge, /inv refill, /inv undo or /inv settings."
msgstr "/inv, /inv sort, /inv columns, /inv merge, /inv refill, /inv undo an /inv settings bi kar bîne."

